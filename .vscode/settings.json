{
    "files.exclude": {
        "Drivers": true,
        "Core": true,
        "EWARM": true,
        ".mxproject": true,
        "ECHO.ioc": true,
        "startup_stm32g431xx.s": true,
        "STM32G431xx_FLASH.ld": true,
        "build": true,
        "cmake": true
    },
    "search.exclude": {
        "Drivers/**": true,
        "Core/**": true,
        "EWARM/**": true,
        "build/**": true,
        "cmake/**": true
    },
    "files.watcherExclude": {
        "**/build/**": true
    },
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/Debug/compile_commands.json",
    "C_Cpp.intelliSenseEngine": "default",
    "stm32cube-ide-clangd.enable": false,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.configureOnOpen": false,
    "cmake.useCMakePresets": "always",
    "editor.tabSize": 4,
    "files.associations": {
        "*.h": "c",
        "inductance.h": "cpp",
        "resistance.h": "cpp",
        "capacitance.h": "cpp"
    }
}
