# A cache belongs to one source/build location, not to a Git branch.
# Keep normal incremental builds; reset only caches copied from another location.
if(NOT DEFINED ECHO_PROJECT_DIR OR NOT ECHO_CONFIGURATION MATCHES "^(Debug|Release)$")
    message(FATAL_ERROR "Expected ECHO_PROJECT_DIR and a Debug or Release configuration.")
endif()

function(normalize_path path output)
    if(EXISTS "${path}")
        file(REAL_PATH "${path}" normalized)
    else()
        get_filename_component(normalized "${path}" ABSOLUTE)
    endif()
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${normalized}" normalized)
    endif()
    set(${output} "${normalized}" PARENT_SCOPE)
endfunction()

normalize_path("${ECHO_PROJECT_DIR}" project_dir)
set(build_dir "${project_dir}/build/${ECHO_CONFIGURATION}")
normalize_path("${build_dir}" expected_build_dir)
set(cache "${build_dir}/CMakeCache.txt")
if(NOT EXISTS "${cache}")
    return()
endif()

file(STRINGS "${cache}" locations
    REGEX "^CMAKE_(HOME_DIRECTORY|CACHEFILE_DIR):INTERNAL=")
set(moved FALSE)
foreach(location IN LISTS locations)
    string(REGEX REPLACE "^[^=]*=" "" cached_path "${location}")
    normalize_path("${cached_path}" cached_path)
    if(location MATCHES "^CMAKE_HOME_DIRECTORY:")
        if(NOT cached_path STREQUAL project_dir)
            set(moved TRUE)
        endif()
    elseif(NOT cached_path STREQUAL expected_build_dir)
        set(moved TRUE)
    endif()
endforeach()

if(moved)
    # Never follow a redirected build directory when removing generated files.
    set(expected_location "${build_dir}")
    if(CMAKE_HOST_WIN32)
        string(TOLOWER "${expected_location}" expected_location)
    endif()
    if(NOT expected_build_dir STREQUAL expected_location
       OR IS_SYMLINK "${cache}" OR IS_SYMLINK "${build_dir}/CMakeFiles")
        message(FATAL_ERROR "Refusing to reset a cache through a redirected build path: ${build_dir}")
    endif()
    message(STATUS "Project location changed; regenerating the ${ECHO_CONFIGURATION} CMake cache.")
    file(REMOVE "${cache}")
    file(REMOVE_RECURSE "${build_dir}/CMakeFiles")
endif()
